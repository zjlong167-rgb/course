              "content": {
                "label": "SYN",
                "packet": {
                  "source": "client",
                  "target": "server",
                  "protocol": "TCP",
                  "sourcePort": 49152,
                  "targetPort": 80,
                  "flags": "SYN",
                  "seq": 100,
                  "bytes": 60
                }
              },
              "details": {
                "报文含义": "客户端告诉服务端：我的初始序列号是 100，请从 101 开始确认。",
                "序列号规则": "SYN 消耗一个序列号；不携带数据的 ACK 不消耗序列号。",
                "大小说明": "60 B 为本演示的简化链路帧大小，不表示固定的 TCP 首部长度。"
              }
