# Copy to an ignored .env; set independent random secrets before starting.
COMPOSE_PROJECT_NAME=course-prod
RELEASE=20261113
HTTP_BIND=0.0.0.0
HTTP_PORT=80
DATA_ROOT=/opt/course-platform/data
MYSQL_DATABASE=course
MYSQL_USER=course
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
BOOTSTRAP_ADMIN_USER=course-admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
COOKIE_SECURE=false
