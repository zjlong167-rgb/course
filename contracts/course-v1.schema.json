{
  "type": "object",
  "properties": {
    "formatVersion": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "category": {
      "enum": [
        "network",
        "business",
        "math",
        "manufacturing"
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "minItems": 0
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 1
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "minItems": 1
    }
  },
  "required": [
    "formatVersion",
    "id",
    "title",
    "summary",
    "category",
    "assets",
    "components",
    "chapters"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://course.local/schema/course-v1.json",
  "$defs": {
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        }
      },
      "required": [
        "id",
        "purpose"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "flow",
            "formula",
            "geometry",
            "annotation"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^1\\.[0-9]+\\.[0-9]+$"
        }
      },
      "required": [
        "type",
        "version"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "node",
            "edge",
            "packet",
            "formula",
            "geometry",
            "text",
            "image"
          ]
        },
        "component": {
          "enum": [
            "flow",
            "formula",
            "geometry",
            "annotation"
          ]
        },
        "position": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            },
            "y": {
              "type": "number",
              "minimum": -100000,
              "maximum": 100000
            }
          },
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false
        },
        "size": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "initial": {
          "type": "object",
          "properties": {
            "visible": {
              "type": "boolean"
            },
            "highlight": {
              "type": "boolean"
            },
            "status": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            }
          },
          "required": [
            "visible",
            "highlight",
            "status"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "tex": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000
            },
            "source": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "assetId": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              },
              "minItems": 3
            },
            "states": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "visual": {
              "enum": [
                "laptop",
                "server",
                "router",
                "cloud"
              ]
            },
            "address": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "packet": {
              "type": "object",
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "protocol": {
                  "enum": [
                    "TCP"
                  ]
                },
                "sourcePort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "targetPort": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "flags": {
                  "enum": [
                    "SYN",
                    "SYN, ACK",
                    "ACK"
                  ]
                },
                "seq": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "ack": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4294967295
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 20,
                  "maximum": 65535
                }
              },
              "required": [
                "source",
                "target",
                "protocol",
                "sourcePort",
                "targetPort",
                "flags",
                "seq",
                "bytes"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "type",
        "component",
        "position",
        "size",
        "initial",
        "content",
        "details"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "show",
            "hide",
            "highlight",
            "move",
            "setState"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "atMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "params": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "target",
        "atMs",
        "durationMs",
        "params"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "show"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hide"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "highlight"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "move"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "y": {
                    "type": "number",
                    "minimum": -100000,
                    "maximum": 100000
                  }
                },
                "required": [
                  "x",
                  "y"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "setState"
              }
            }
          },
          "then": {
            "properties": {
              "params": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 10000
                  }
                },
                "required": [
                  "value"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "narration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 0
        }
      },
      "required": [
        "id",
        "title",
        "narration",
        "durationMs",
        "actions"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "canvas": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100000
            }
          },
          "required": [
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "canvas",
        "objects",
        "steps"
      ],
      "additionalProperties": false
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "scenes"
      ],
      "additionalProperties": false
    }
  }
}
