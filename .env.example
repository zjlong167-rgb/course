# Local development only. Copy values into the current shell or an ignored .env.
MYSQL_DATABASE=course
MYSQL_USER=course
MYSQL_PASSWORD=course_local_only
MYSQL_ROOT_PASSWORD=root_local_only
MYSQL_DSN=course:course_local_only@tcp(127.0.0.1:3307)/course?charset=utf8mb4&parseTime=true&loc=UTC
LISTEN_ADDR=127.0.0.1:8080

# Optional initial account creation; existing passwords/roles are never overwritten.
# Set a unique username and a password of at least 12 characters for first startup.
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=
# Independent persistent file directory; back up together with MySQL.
ASSET_DIR=../.local/assets
# Use true behind production HTTPS; local HTTP uses false.
COOKIE_SECURE=false
